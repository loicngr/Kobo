#!/usr/bin/env python3
"""Install a fresh Kōbō instance behind an existing Traefik. Python 3.10+."""
import argparse
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import sys
import uuid

sys.dont_write_bytecode = True
ASSETS = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader('kobo_updater', str(ASSETS / 'kobo-update'))
spec = importlib.util.spec_from_loader(loader.name, loader)
updater = importlib.util.module_from_spec(spec)
loader.exec_module(updater)
InstallError = updater.UpdateError
TOOLS = ('kobo-install', 'kobo-update', 'kobo-github-app-token', 'kobo-gh', 'kobo-vps-entrypoint')
ENV_KEYS = updater.COMPOSE_ENV_KEYS


def safe_path(value):
    path = Path(value)
    if not path.is_absolute() or any(re.search(r'[\x00-\x1f\x7f\"\'`$,:\\]', str(p)) for p in (path, path.resolve())):
        raise InstallError('Use absolute paths without control characters, quotes, $, commas, colons or backslashes.')
    return path.resolve()


def validate_config(config):
    for name in ('uid', 'gid'):
        value = str(config.get(name, 1000))
        if not re.fullmatch(r'[1-9][0-9]{0,9}', value) or int(value) > 2147483647:
            raise InstallError('UID and GID must be positive non-root numeric IDs.')
    domain = config['domain']
    if (len(domain) > 253 or '.' not in domain or
            not all(re.fullmatch(r'[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?', label)
                    for label in domain.split('.'))):
        raise InstallError('Domain must be a DNS hostname, without scheme, port or path.')
    for name in ('network', 'entrypoint', 'certresolver'):
        if name == 'certresolver' and config[name] == '':
            continue
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,99}', config[name]):
            raise InstallError(f'Invalid {name}; use letters, numbers, dots, underscores or hyphens.')
    projects = safe_path(config['projects_directory'])
    # A bind over the runtime/home/config would hide executables or persistent credentials.
    protected = ('/root', '/app', '/usr', '/bin', '/sbin', '/etc', '/run', '/var', '/proc', '/sys', '/dev')
    if projects == Path('/') or any(projects == Path(p) or Path(p) in projects.parents for p in protected):
        raise InstallError('Projects must be outside container system paths, /app and /root (for example /opt/kobo/projects).')
    if projects.exists() and not projects.is_dir():
        raise InstallError('The projects path must be a directory.')
    if not projects.exists() and 'uid' in config and os.getuid() not in (0, int(config['uid'])):
        raise InstallError('A new projects directory requires --uid to match the installer user, or root. '
                           'Otherwise prepare a directory writable by that UID first.')
    app = [config.get(k) for k in ('github_app_id', 'github_installation_id', 'github_private_key')]
    if any(app):
        if not all(app):
            raise InstallError('GitHub App requires all three flags: App ID, installation ID and private key.')
        if not re.fullmatch(r'[A-Za-z0-9_.-]{1,100}', app[0]) or not re.fullmatch(r'[1-9][0-9]*', app[1]):
            raise InstallError('Invalid GitHub App or installation ID.')
        key = safe_path(app[2])
        if not key.is_file() or not os.access(key, os.R_OK) or key.stat().st_mode & 0o077:
            raise InstallError('The GitHub private key must be a readable regular file with private permissions (0600).')
        if 'uid' in config and key.stat().st_uid != int(config['uid']):
            raise InstallError('The GitHub private key owner must match --uid so the non-root agent can read it.')
        if 'uid' in config and os.getuid() not in (0, int(config['uid'])):
            raise InstallError('Run the installer as --uid (or root) to create readable private GitHub configuration.')
    if config['version'] != 'latest':
        updater.normalize_version(config['version'])


def render(config, stack):
    text = (ASSETS.parent / 'docker-compose.vps.yml').read_text()
    if not config['certresolver']:
        text = '\n'.join(line for line in text.split('\n') if 'tls.certresolver:' not in line)
    if config['docker_socket']:
        text = text.replace('      # - /var/run/docker.sock:', '      - /var/run/docker.sock:')
    if config.get('github_app_id'):
        mounts = ''
        for source, target in (
            (stack / 'bin/kobo-gh', '/usr/local/bin/gh'),
            (stack / 'bin/kobo-github-app-token', '/usr/local/bin/kobo-github-app-token'),
            (stack / 'auth/github-app.json', '/etc/kobo/github-app.json'),
            (safe_path(config['github_private_key']), '/run/secrets/kobo-github-app.pem'),
        ):
            mounts += (f'      - type: bind\n        source: {json.dumps(str(source))}\n'
                       f'        target: {target}\n        read_only: true\n'
                       '        bind:\n          create_host_path: false\n')
        text = text.replace('    networks:\n', mounts + '    networks:\n', 1)
    values = (config['domain'], config['projects_directory'], config['network'],
              config['entrypoint'], config['certresolver'], str(config.get('uid', 1000)), str(config.get('gid', 1000)))
    env = ''.join(f"{key}='{value}'\n" for key, value in zip(ENV_KEYS, values))
    return text, env


def digest(name, data):
    # kobo-update owns the image pin after installation; all other edits still require review.
    if name == 'compose.yaml':
        data = updater.image_config(data.decode(), 'kobo:managed').encode()
    return hashlib.sha256(data).hexdigest()


class Installer(updater.Updater):
    def __init__(self, stack):
        super().__init__(safe_path(str(stack)))
        self.manifest = self.stack / '.kobo-install.json'
        self.project_name = 'kobo'
        self.state = json.loads(self.manifest.read_text()) if self.manifest.exists() else {}
        if self.state and (self.state.get('format') != 1 or self.state.get('directory') != str(self.stack)):
            raise InstallError('Unrecognized or relocated installation manifest; review it manually.')

    def preflight(self, config):
        for tool in ('docker', 'git'):
            if not shutil.which(tool):
                raise InstallError(f'Install {tool} first.')
        endpoint = os.environ.get('DOCKER_HOST')
        if not endpoint or os.environ.get('DOCKER_CONTEXT'):
            context = json.loads(self.run(['docker', 'context', 'inspect']))[0]
            endpoint = context['Endpoints']['docker']['Host']
        if not endpoint.startswith('unix://'):
            raise InstallError('Run this installer on the Docker host using a local Unix socket context.')
        info = json.loads(self.run(['docker', 'info', '--format', '{{json .}}']))
        if info.get('OSType') != 'linux' or info.get('Architecture') not in ('x86_64', 'amd64'):
            raise InstallError('This image currently requires Linux amd64.')
        self.run(['docker', 'compose', 'version'])
        self.run(['docker', 'network', 'inspect', config['network']])
        if config['docker_socket'] and not Path('/var/run/docker.sock').is_socket():
            raise InstallError('Docker socket access requires /var/run/docker.sock on this host.')

    def discover(self):
        """Suggest CLI/env-based Traefik settings without displaying raw container configuration."""
        found = {name: set() for name in ('network', 'entrypoint', 'certresolver')}
        ids = self.run(['docker', 'ps', '-q']).split()
        if not ids:
            return found
        for container in json.loads(self.run(['docker', 'inspect', *ids])):
            config = container.get('Config', {})
            if 'traefik' not in config.get('Image', '').lower():
                continue
            found['network'].update(name for name in container.get('NetworkSettings', {}).get('Networks', {})
                                    if name not in {'bridge', 'host', 'none'})
            args = (config.get('Cmd') or []) + (config.get('Env') or [])
            for arg in args:
                entry = re.fullmatch(r'--entrypoints\.([\w-]+)\.address=:(?:443)(?:/tcp)?', arg, re.I)
                env_entry = re.fullmatch(r'TRAEFIK_ENTRYPOINTS_([\w-]+)_ADDRESS=:443(?:/tcp)?', arg, re.I)
                resolver = re.match(r'--certificatesresolvers\.([\w-]+)\.', arg, re.I)
                env_resolver = re.match(r'TRAEFIK_CERTIFICATESRESOLVERS_([\w-]+)_ACME_', arg, re.I)
                if entry or env_entry:
                    found['entrypoint'].add((entry or env_entry).group(1).lower())
                if resolver or env_resolver:
                    found['certresolver'].add((resolver or env_resolver).group(1).lower())
        return found

    def collisions(self):
        containers = self.run(['docker', 'ps', '-aq', '--filter', 'label=com.docker.compose.project=kobo'])
        volumes = self.run(['docker', 'volume', 'ls', '-q', '--filter', 'name=^kobo_kobo-home$'])
        routers = self.run(['docker', 'ps', '-aq', '--filter', 'label=traefik.http.routers.kobo.rule'])
        if containers or volumes or routers:
            raise InstallError('Compose project kobo, router kobo or volume kobo_kobo-home already exists. Refusing to adopt or replace it.')

    def assert_fresh(self):
        for name in ('compose.yaml', '.env', '.kobo-install.json', 'bin', 'auth', 'docker-compose.vps.yml'):
            path = self.stack / name
            if path.exists() or path.is_symlink():
                raise InstallError(f'Unmanaged installation file already exists: {path}. Use the manual guide.')

    def save(self, **changes):
        self.state.update(changes)
        updater.atomic_write(self.manifest, (json.dumps(self.state, indent=2) + '\n').encode())

    def initialize(self, config):
        self.assert_fresh()
        compose, env = render(config, self.stack)
        files = {'compose.yaml': compose.encode(), '.env': env.encode(),
                 'docker-compose.vps.yml': (ASSETS.parent / 'docker-compose.vps.yml').read_bytes()}
        files.update({f'bin/{name}': (ASSETS / name).read_bytes() for name in TOOLS})
        if config.get('github_app_id'):
            files['auth/github-app.json'] = json.dumps({
                'app_id': config['github_app_id'], 'installation_id': config['github_installation_id'],
                'private_key': '/run/secrets/kobo-github-app.pem',
            }, indent=2).encode()
        self.stack.mkdir(parents=True, exist_ok=True, mode=0o700)
        # Record intent first. An interrupted file copy is explicit, never silently adopted.
        self.save(format=1, directory=str(self.stack), config=config, phase='writing-files',
                  hashes={name: digest(name, data) for name, data in files.items()})
        for name, data in files.items():
            path = self.stack / name
            path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            updater.atomic_write(path, data, 0o755 if name.startswith('bin/') else 0o600)
            if name == 'auth/github-app.json' and os.getuid() == 0:
                os.chown(path, int(config.get('uid', 1000)), int(config.get('gid', 1000)))
        projects = Path(config['projects_directory'])
        projects_existed = projects.exists()
        projects.mkdir(parents=True, exist_ok=True)
        if not projects_existed and os.getuid() == 0:
            os.chown(projects, int(config.get('uid', 1000)), int(config.get('gid', 1000)))
        self.save(phase='configured')

    def verify_files(self):
        if self.state['phase'] == 'writing-files':
            raise InstallError('File preparation was interrupted. Review .kobo-install.json and files before retrying; nothing was started.')
        for name, expected in self.state['hashes'].items():
            path = self.stack / name
            if path.is_symlink() or not path.is_file() or digest(name, path.read_bytes()) != expected:
                raise InstallError(f'Managed file changed or missing: {path}. Preserved; review it manually.')
        if self.state['phase'] != 'complete' and self.state.get('image'):
            if f'    image: {self.state["image"]}\n' not in self.compose_file.read_text():
                raise InstallError('Prepared image was changed; refusing to start it.')

    def validate_compose(self, config):
        # No files or directories are needed for --check. All substitutions are supplied explicitly.
        text, _ = render(config, self.stack)
        for key, value in zip(ENV_KEYS, (config['domain'], config['projects_directory'], config['network'],
                                       config['entrypoint'], config['certresolver'],
                                       str(config.get('uid', 1000)), str(config.get('gid', 1000)))):
            text = re.sub(r'\$\{' + key + r'(?::[^}]*)?\}', lambda _: value, text)
        self.run(['docker', 'compose', '--env-file', '/dev/null', '-p', 'kobo', '-f', '-', 'config', '--quiet'],
                 data=text.encode())

    def configure_github(self):
        # Legacy prepared installations retain their original root execution.
        runtime = ['kobo-vps-entrypoint', '--exec'] if 'uid' in self.state.get('config', {}) else []
        self.run(self.compose('exec', '-T', 'kobo', *runtime, '/usr/local/bin/kobo-github-app-token', '--check'))
        helper = 'credential.https://github.com.helper'
        self.run(self.compose('exec', '-T', 'kobo', *runtime, 'git', 'config', '--global', '--replace-all', helper, ''))
        self.run(self.compose('exec', '-T', 'kobo', *runtime, 'git', 'config', '--global', '--add', helper,
                             '!/usr/local/bin/gh auth git-credential'))

    def assert_started(self):
        container = self.run(self.compose('ps', '-aq', 'kobo'))
        if not container or len(container.split()) != 1:
            raise InstallError('Expected installation container is missing or ambiguous. Inspect compose ps; no automatic restart was attempted.')
        info = json.loads(self.run(['docker', 'inspect', container]))[0]
        expected_hash = self.run(self.compose('config', '--hash', 'kobo')).split()
        labels = info.get('Config', {}).get('Labels', {}) or {}
        state = info.get('State', {})
        expected_labels = {'com.docker.compose.project': 'kobo', 'com.docker.compose.service': 'kobo',
                           'com.docker.compose.project.working_dir': str(self.stack)}
        if (not state.get('Running') or state.get('Health', {}).get('Status') != 'healthy'
                or info.get('Config', {}).get('Image') != self.state['image']
                or any(labels.get(key) != value for key, value in expected_labels.items())
                or len(expected_hash) != 2 or expected_hash[0] != 'kobo'
                or labels.get('com.docker.compose.config-hash') != expected_hash[1]):
            raise InstallError('Installation container is unhealthy or differs from the prepared configuration. Inspect compose ps and private logs; no automatic restart was attempted.')
        self.container = container

    def finish(self, config):
        # A previous up may have succeeded even if its CLI or the HTTPS check failed.
        # Verify ownership before doing anything; never recreate an uncertain container.
        self.assert_started()
        self.save(phase='verifying')
        if config.get('github_app_id') and not self.state.get('github_configured'):
            self.configure_github()
            self.save(github_configured=True)
        self.public_url = 'https://' + config['domain']
        self.verify(self.state['version'])
        self.save(phase='complete')
        print(f'Kōbō is ready at {self.public_url}. Follow docs/deployment-vps.md to retrieve the private login link and sign in to an engine.')

    def execute(self, config, check=False, prepare=False):
        validate_config(config)
        if self.state:
            if config != self.state['config']:
                raise InstallError('This directory is already configured with different options. No reconfiguration was applied.')
            self.verify_files()
        else:
            self.assert_fresh()
        self.preflight(config)
        if not self.state or self.state['phase'] in {'configured', 'building', 'prepared'}:
            self.collisions()
        self.validate_compose(config)
        if check:
            print('Configuration and local Docker checks passed. No files, images or containers changed.')
            return
        if self.state.get('phase') == 'complete':
            print('Installation already complete; no restart or reconfiguration. Use bin/kobo-update to upgrade.')
            return
        if self.state.get('phase') in {'starting', 'verifying'}:
            if prepare:
                raise InstallError('Start was already attempted. Inspect compose ps or rerun without --prepare to verify it.')
            self.finish(config)
            return
        if not self.state:
            self.initialize(config)
        if self.state['phase'] != 'prepared':
            self.installed = '0.0.0'
            version, sha = self.resolve(config['version'])
            self.job = self.stack / 'install-builds' / uuid.uuid4().hex
            self.job.mkdir(mode=0o700, parents=True)
            self.log = self.job / 'install.log'
            self.log.touch(mode=0o600)
            self.save(phase='building', version=version, sha=sha, log=str(self.log))
            print(f'Building Kōbō {version}. Private log: {self.log}', flush=True)
            image = self.build(version, sha)
            # Older release images also need the explicit helper dependencies.
            self.run(['docker', 'run', '--rm', '--network', 'none', '--entrypoint', 'sh', image,
                      '-c', 'python3 -c "import sys; assert sys.version_info >= (3,10)" && openssl version'])
            self.verify_files()
            self.save(phase='pinning', image=image)
            updater.atomic_write(self.compose_file, updater.image_config(self.compose_file.read_text(), image).encode())
            self.save(phase='prepared')
        if prepare:
            print('Image and configuration ready. Run the same command without --prepare to start.')
            return
        self.verify_files()
        self.collisions()
        self.run(self.compose('config', '--quiet'))
        self.save(phase='starting')
        self.run(self.compose('up', '-d', '--wait', '--wait-timeout', '180', 'kobo'), timeout=240)
        self.finish(config)


def arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--directory', type=Path, required=True)
    parser.add_argument('--uid', help='Non-root runtime UID (defaults to the invoking user).')
    parser.add_argument('--gid', help='Runtime GID (defaults to the invoking user).')
    for name in ('domain', 'projects-directory', 'network', 'entrypoint', 'certresolver', 'version',
                 'github-app-id', 'github-installation-id', 'github-private-key'):
        parser.add_argument('--' + name)
    parser.add_argument('--docker-socket', action='store_true', default=None,
                        help='Give agents root-equivalent access to this host through Docker.')
    parser.add_argument('--yes', action='store_true', help='Use explicit flags without interactive questions.')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='Read-only local prerequisite/configuration checks.')
    mode.add_argument('--prepare', action='store_true', help='Write configuration and build without starting.')
    return parser.parse_args(argv)


def configure(args, installer):
    names = ('domain', 'projects_directory', 'network', 'entrypoint', 'certresolver', 'version',
             'github_app_id', 'github_installation_id', 'github_private_key', 'docker_socket', 'uid', 'gid')
    config = installer.state.get('config', {}).copy()
    config.update({name: getattr(args, name) for name in names if getattr(args, name) is not None})
    interactive = sys.stdin.isatty() and not args.yes
    suggestions = installer.discover() if interactive and not installer.state else {}

    def ask(name, label, default=None):
        if name in config:
            return
        if interactive:
            options = sorted(suggestions.get(name, []))
            if len(options) == 1:
                default = options[0]
            if options:
                print(f'Detected {name}: {", ".join(options)}')
            answer = input(f'{label}' + (f' [{default}]' if default is not None else '') + ': ').strip()
            config[name] = answer or default
        else:
            config[name] = default
        if config[name] is None:
            raise InstallError(f'Missing --{name.replace("_", "-")}.')

    ask('domain', 'Public hostname')
    ask('projects_directory', 'Projects directory', str(installer.stack / 'projects'))
    ask('network', 'Existing Traefik Docker network')
    ask('entrypoint', 'Traefik HTTPS entrypoint')
    ask('certresolver', 'Traefik certificate resolver (empty for preloaded certificate)', '')
    ask('version', 'Stable release version', 'latest')
    # Do not silently change an already managed deployment's recorded config.
    if not installer.state:
        ask('uid', 'Host user ID for Kōbō and agents', str(os.getuid() or 1000))
        ask('gid', 'Host group ID for Kōbō and agents', str(os.getgid() or 1000))
    if config.get('docker_socket') is None:
        config['docker_socket'] = interactive and input('Give agents Docker access (root-equivalent host control)? [y/N]: ').lower() == 'y'
    if not any(config.get(name) for name in ('github_app_id', 'github_installation_id', 'github_private_key')):
        if interactive and input('Configure a GitHub App bot? [y/N]: ').lower() == 'y':
            ask('github_app_id', 'GitHub App client ID or App ID')
            ask('github_installation_id', 'GitHub installation ID')
            ask('github_private_key', 'Absolute path to private RSA key (0600)')
    for name in ('github_app_id', 'github_installation_id', 'github_private_key'):
        config.setdefault(name, None)
    config['projects_directory'] = str(safe_path(config['projects_directory']))
    if config['github_private_key']:
        config['github_private_key'] = str(safe_path(config['github_private_key']))
    return config


def main(argv=None):
    args = arguments(argv)
    try:
        installer = Installer(args.directory)
        config = configure(args, installer)
        validate_config(config)
        if args.check:
            installer.execute(config, check=True)
            return 0
        print(f'Install directory: {installer.stack}\nURL: https://{config["domain"]}\n'
              f'Projects: {config["projects_directory"]}\nDocker socket: {config["docker_socket"]}\n'
              f'Runtime UID:GID: {config.get("uid", "legacy")}:{config.get("gid", "legacy")}\n'
              f'GitHub App: {bool(config["github_app_id"])}')
        if not args.yes and not installer.state:
            if not sys.stdin.isatty() or input('Create this installation? [y/N]: ').lower() != 'y':
                raise InstallError('Installation not started. Use --yes with explicit configuration for unattended setup.')
        installer.stack.mkdir(mode=0o700, parents=True, exist_ok=True)
        with (installer.stack / '.update.lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise InstallError('An installer or updater already holds this directory lock.') from None
            # Reload after locking so concurrent installers cannot adopt one another's stale state.
            installer = Installer(args.directory)
            installer.execute(config, prepare=args.prepare)
        return 0
    except (InstallError, OSError, ValueError, KeyError, EOFError) as error:
        print(str(error) if isinstance(error, InstallError) else
              'Installation failed: check local paths, prerequisites and the private installation state.', file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print('Interrupted. Files and data retained; inspect .kobo-install.json before resuming.', file=sys.stderr)
        return 130


if __name__ == '__main__':
    sys.exit(main())
