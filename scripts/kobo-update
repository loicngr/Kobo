#!/usr/bin/env python3
"""Update a standalone Kōbō Compose deployment. Python 3.10+; standard library only."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone

REPO = 'https://github.com/loicngr/kobo.git'
# Allow Kōbō's bounded shutdown hooks and subsequent dev-service teardown to finish.
STOP_GRACE_SECONDS = 180
VERSION = re.compile(r'\d+\.\d+\.\d+')
COMPOSE_ENV_KEYS = ('KOBO_DOMAIN', 'KOBO_PROJECTS_DIR', 'TRAEFIK_NETWORK',
                    'TRAEFIK_ENTRYPOINT', 'TRAEFIK_CERTRESOLVER', 'KOBO_UID', 'KOBO_GID')
BUSY_JS = r"""
const db = new (require('better-sqlite3'))('/root/.config/kobo/kobo.db', {readonly:true});
const sessions = db.prepare("SELECT count(*) n FROM agent_sessions WHERE status = 'running'").get().n;
const workspaces = db.prepare("SELECT count(*) n FROM workspaces WHERE status IN ('extracting','brainstorming','executing','compacting')").get().n;
console.log(JSON.stringify({sessions, workspaces}));
"""
MIGRATION_JS = r"""
import Database from 'better-sqlite3';
import { runMigrations } from './dist/server/db/migrations.js';
const db = new Database('/check/kobo.db');
db.pragma('foreign_keys = ON');
runMigrations(db);
if (db.pragma('integrity_check', {simple:true}) !== 'ok') throw new Error('SQLite integrity check failed');
if (db.pragma('foreign_key_check').length) throw new Error('SQLite foreign key check failed');
db.close();
"""
API_JS = r"""
(async () => {
const fs = require('fs');
const token = JSON.parse(fs.readFileSync('/root/.config/kobo/settings.json','utf8')).global.networkAccessToken;
if (!token) throw new Error('Missing network token');
const headers = {'X-Kobo-Token': token};
const r = await fetch(`http://127.0.0.1:${process.env.SERVER_PORT || 3000}/api/workspaces`,{headers,signal:AbortSignal.timeout(10000)});
if (!r.ok) throw new Error('Authenticated API check failed');
console.log('API authenticated: OK');
})().catch(() => process.exit(1));
"""
MAINTENANCE_JS = r"""
(async () => {
const fs = require('fs');
const token = JSON.parse(fs.readFileSync('/root/.config/kobo/settings.json','utf8')).global.networkAccessToken;
if (!token) throw new Error('Missing network token');
const method = process.argv[1];
const options = {method, headers:{'X-Kobo-Token':token,'Content-Type':'application/json'}, signal:AbortSignal.timeout(10000)};
if (method !== 'GET') options.body = JSON.stringify({owner:process.argv[2]});
const r = await fetch(`http://127.0.0.1:${process.env.SERVER_PORT || 3000}/api/maintenance/update`,options);
const body = await r.json().catch(() => ({}));
console.log(JSON.stringify({status:r.status, protocol:body.protocol}));
})().catch(() => process.exit(1));
"""
TRIGGER_JS = r"""
(async () => {
const fs = require('fs');
const token = JSON.parse(fs.readFileSync('/root/.config/kobo/settings.json','utf8')).global.networkAccessToken;
if (!token) throw new Error('Missing network token');
const [method, path, body, timeout] = process.argv.slice(1);
const options = {method, headers:{'X-Kobo-Token':token,'Content-Type':'application/json'}, signal:AbortSignal.timeout(Number(timeout) || 10000)};
if (body) options.body = body;
const r = await fetch(`http://127.0.0.1:${process.env.SERVER_PORT || 3000}/api/maintenance/${path}`,options);
console.log(JSON.stringify({status:r.status, body:await r.json().catch(() => ({}))}));
})().catch(() => process.exit(1));
"""
BUSY_MESSAGE = 'Kōbō is busy: wait for agents or stop them in the UI, then retry.'
# Updater phase -> phase reported to Kōbō; 'prepared' is never reported.
# 'reserving' is not reported: the restart is announced once the reservation is obtained.
REPORTED_PHASES = {'building': 'building', 'stopping': 'restarting',
                   'backed-up': 'restarting', 'backup-skipped': 'restarting', 'launching': 'restarting',
                   'complete': 'complete', 'aborted': 'aborted', 'recovery-required': 'recovery-required'}
UNIT_NAME = 'kobo-ui-update'
UNIT_DIR = Path('/etc/systemd/system')
UNSAFE_UNIT_PATH = re.compile(r'[\s"\'\\\\%$]')
UNIT_USER = re.compile(r'[A-Za-z_][A-Za-z0-9_.-]*\$?')
REPORT_REASONS = ('busy', 'already-running', 'interrupted-update', 'legacy-runtime', 'unknown')
FINAL_PHASES = ('complete', 'up-to-date', 'refused', 'aborted', 'recovery-required')


class UpdateError(Exception):
    def __init__(self, message, code=None):
        super().__init__(message)
        self.code = code


def atomic_write(path, data, mode=0o600):
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(name, mode)
        os.replace(name, path)
        parent_fd = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def image_config(text, image):
    # Refuse an unexpected/multi-service structure instead of modifying other services.
    pattern = r'(?m)^    image: [^\n]+$'
    if len(re.findall(pattern, text)) != 1:
        raise UpdateError('Unexpected Compose layout: exactly one indented image entry is required.')
    return re.sub(pattern, '    image: ' + image, text)


def normalize_version(value):
    value = value.removeprefix('v')
    if not VERSION.fullmatch(value):
        raise UpdateError('Expected a stable version such as 2.1.16 (or latest).')
    return value


def say(message):
    print(message, flush=True)


class Updater:
    def __init__(self, stack):
        self.stack = stack.resolve()
        self.compose_file = self.stack / 'compose.yaml'
        self.log = None
        self.job = None
        self.state = {}
        self.container = None
        self.project_name = None
        self.public_url = None
        self.maintenance_owner = uuid.uuid4().hex

    # UI-requested run: {'id', 'skipBackup', 'stopAgents'}; None for every command-line run.
    ui = None
    reported = None  # last phase sent, to never repeat it
    refused = None  # code of a coded refusal that ends before the container was stopped

    def command_environment(self, args):
        env = os.environ.copy()
        if args[:2] == ['docker', 'compose']:
            # Deployment inputs come from the selected stack's .env, never an
            # unrelated caller shell. Keep Docker context and authentication.
            for key in list(env):
                if key in COMPOSE_ENV_KEYS or key.startswith('COMPOSE_'):
                    del env[key]
        return env

    def run(self, args, timeout=120, data=None):
        try:
            result = subprocess.run(args, input=data, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, timeout=timeout, check=False,
                                    env=self.command_environment(args))
        except subprocess.TimeoutExpired as e:
            raise UpdateError(f'Timeout: {args[0]}') from e
        if result.returncode:
            if self.log:
                with self.log.open('ab') as f:
                    f.write(result.stderr)
            raise UpdateError(f'Failed: {args[0]} (code {result.returncode}). See the private update log.')
        return result.stdout.decode().strip()

    def logged(self, args, timeout=3600):
        with self.log.open('ab') as f:
            try:
                subprocess.run(args, stdout=f, stderr=subprocess.STDOUT,
                               timeout=timeout, check=True, env=self.command_environment(args))
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
                raise UpdateError(f'Failed: {args[0]}. Log: {self.log}') from e

    def compose(self, *args, file=None):
        project = ['-p', self.project_name] if self.project_name else []
        return ['docker', 'compose', '--project-directory', str(self.stack),
                '--env-file', str(self.stack / '.env'),
                *project, '-f', str(file or self.compose_file), *args]

    def record(self, phase, **values):
        self.state.update(values, phase=phase)
        atomic_write(self.job / 'state.json', json.dumps(self.state, indent=2).encode())
        # A SIGTERM during the docker exec of a terminal report turns the phase into recovery-required
        # although the update finished: conservative, accepted.
        if phase == 'aborted' and self.refused:
            self.report('refused', self.refused)
        elif phase in REPORTED_PHASES:
            self.report(REPORTED_PHASES[phase])

    def forced_stop(self):
        return bool(self.ui and self.ui['stopAgents'])

    def trigger(self, method, path, body=None, timeout=10):
        """Call /api/maintenance/<path> inside the container; None on any failure."""
        try:
            return json.loads(self.run(['docker', 'exec', self.container, 'node', '-e', TRIGGER_JS, method, path,
                                        json.dumps(body) if body is not None else '', str(timeout * 1000)],
                                       timeout=timeout + 20))
        except Exception:
            return None

    def report(self, phase, reason=None):
        if not self.ui or phase == self.reported:
            return
        self.reported = phase
        if reason is not None and reason not in REPORT_REASONS:
            reason = 'unknown'  # never send a value Kōbō does not know
        if phase in FINAL_PHASES:
            # `up` recreates the container when the image changes: send to the one running now.
            # No single container found keeps the previous id: the report stays best effort.
            self.locate()
        self.trigger('POST', 'update-trigger/report',
                     {'id': self.ui['id'], 'phase': phase, **({'reason': reason} if reason else {})})

    def locate(self):
        try:
            ids = self.run(self.compose('ps', '-q', 'kobo')).splitlines()
        except Exception:
            return False
        if len(ids) != 1:
            return False
        self.container = ids[0]
        return True

    def idle(self):
        if self.forced_stop():
            return  # agents are stopped by Kōbō itself after the build
        counts = json.loads(self.run(['docker', 'exec', self.container, 'node', '-e', BUSY_JS]))
        if counts['sessions'] or counts['workspaces']:
            raise UpdateError(BUSY_MESSAGE, code='busy')

    def maintenance(self, method):
        reply = json.loads(self.run(['docker', 'exec', self.container, 'node', '-e',
                                     MAINTENANCE_JS, method, self.maintenance_owner]))
        if method == 'DELETE' and reply['status'] == 409:
            return  # Our reservation was never acquired or has already been released.
        if reply['status'] == 404 or (reply['status'] == 200 and reply.get('protocol') != 1):
            raise UpdateError('Runtime lacks atomic update reservation. Use --prepare and perform the first upgrade manually; see the VPS guide.', code='legacy-runtime')
        if reply['status'] != 200:
            # A 409 on POST: an agent started after the idle check.
            busy = 'busy' if method == 'POST' and reply['status'] == 409 else None
            raise UpdateError(f'Update reservation {method} refused (HTTP {reply["status"]}).', code=busy)

    def inspect(self):
        ids = self.run(self.compose('ps', '-q', 'kobo')).splitlines()
        if len(ids) != 1:
            raise UpdateError('Exactly one running Kōbō container is required.')
        self.container = ids[0]
        info = json.loads(self.run(['docker', 'inspect', self.container]))[0]
        if not info['State']['Running']:
            raise UpdateError('The Kōbō container is stopped.')
        mounts = [m for m in info['Mounts'] if m['Destination'] == '/root']
        if len(mounts) != 1 or mounts[0]['Type'] != 'volume':
            raise UpdateError('Expected a named /root volume; no changes made.')
        if any(m['Destination'].startswith('/root/') for m in info['Mounts']):
            raise UpdateError('Nested /root mounts would escape the home backup. This layout is not supported.')
        config = json.loads(self.run(self.compose('config', '--format', 'json')))
        self.config_snapshot = config
        if set(config['services']) != {'kobo'}:
            raise UpdateError('This script requires a standalone stack containing only the kobo service.')
        configured_mounts = config['services']['kobo'].get('volumes', [])
        home = [v for v in configured_mounts if v['target'] == '/root']
        if (len(home) != 1 or home[0]['type'] != 'volume'
                or config.get('volumes', {}).get(home[0]['source'], {}).get('name') != mounts[0]['Name']
                or any(v['target'].startswith('/root/') for v in configured_mounts)):
            raise UpdateError('Compose home mounts do not match the running persistent volume.')
        self.project_name = config['name']
        env = config['services']['kobo'].get('environment', {})
        host = env.get('KOBO_NETWORK_ACCESS_PROXY_HOST', '')
        if not re.fullmatch(r'[A-Za-z0-9.-]+(?::[0-9]+)?', host):
            raise UpdateError('Set KOBO_NETWORK_ACCESS_PROXY_HOST to your HTTPS hostname.')
        if env.get('KOBO_HOME') != '/root/.config/kobo':
            raise UpdateError('This updater requires KOBO_HOME=/root/.config/kobo and a named /root volume.')
        self.public_url = 'https://' + host
        if config['services']['kobo']['image'] != info['Config']['Image']:
            raise UpdateError('Compose and the running container use different images. Reconcile them before updating.')
        self.old_image = info['Image']  # immutable digest, for backup/migration helpers
        self.volume = mounts[0]['Name']
        self.original = self.compose_file.read_bytes()
        self.original_mode = self.compose_file.stat().st_mode & 0o777
        image_config(self.original.decode(), 'kobo:validation')
        self.installed = normalize_version(self.run(['docker', 'exec', self.container,
                                   'node', '-p', 'require("./package.json").version']))
        self.idle()
        self.run(['docker', 'compose', 'version'])
        used_kib = int(self.run(['docker', 'exec', self.container, 'du', '-sk', '/root/.config/kobo']).split()[0])
        # Sources/build layers plus archive + migration copy; compression is not assumed.
        required = 6 * 1024**3 + used_kib * 1024 * 2
        docker_root = self.run(['docker', 'info', '--format', '{{.DockerRootDir}}'])
        docker_free = int(self.run(['docker', 'run', '--rm', '--network', 'none',
            '--read-only', '--entrypoint', 'node', '--mount',
            f'type=bind,src={docker_root},dst=/docker,readonly', self.old_image,
            '-e', "const s=require('fs').statfsSync('/docker');console.log(s.bavail*s.bsize)"]))
        if min(shutil.disk_usage(self.stack).free, docker_free) < required:
            raise UpdateError(f'Insufficient disk space: need at least {required / 1024**3:.1f} GiB free.')
        return info['Config']['Image']

    def resolve(self, requested):
        if requested == 'latest':
            with urllib.request.urlopen('https://registry.npmjs.org/@loicngr%2fkobo/latest', timeout=30) as r:
                requested = json.load(r)['version']
        version = normalize_version(requested)
        if tuple(map(int, version.split('.'))) < tuple(map(int, self.installed.split('.'))):
            raise UpdateError('Downgrade refused: an older image may be incompatible with the current database.')
        # Public repository: no App token is needed to discover/retrieve a release.
        refs = self.run(['git', '-c', 'credential.helper=', 'ls-remote', '--exit-code',
                         REPO, f'refs/tags/v{version}', f'refs/tags/v{version}^{{}}'])
        pairs = [line.split() for line in refs.splitlines()]
        sha = next((sha for sha, ref in pairs if ref.endswith('^{}')), pairs[0][0])
        if not re.fullmatch('[a-f0-9]{40}', sha):
            raise UpdateError('Invalid release reference.')
        return version, sha

    def build(self, version, sha):
        source = self.job / 'source'
        source.mkdir()
        self.logged(['git', 'init', str(source)])
        self.logged(['git', '-C', str(source), '-c', 'credential.helper=', 'fetch',
                     '--depth=1', REPO, f'refs/tags/v{version}'])
        self.logged(['git', '-C', str(source), 'checkout', '--detach', 'FETCH_HEAD'])
        actual = self.run(['git', '-C', str(source), 'rev-parse', 'HEAD'])
        if actual != sha or json.loads((source / 'package.json').read_text())['version'] != version:
            raise UpdateError('Release changed or package.json does not match the tag.')
        # Never overwrite a tag still used by production or a rollback configuration.
        build_id = self.job.name.lower()
        base = f'kobo:{version}-{sha[:12]}-base-{build_id}'
        image = f'kobo:{version}-{sha[:12]}-vps-{build_id}'
        self.logged(['docker', 'build', '--progress=plain', '-t', base, str(source)])
        overlay = self.job / 'overlay'
        overlay.mkdir()
        launcher = Path(__file__).resolve().with_name('kobo-vps-entrypoint')
        if not launcher.is_file():
            raise UpdateError('Install kobo-vps-entrypoint beside kobo-update before building an image.')
        shutil.copyfile(launcher, overlay / 'kobo-vps-entrypoint')
        (overlay / 'Dockerfile').write_text(
            f'FROM {base}\nUSER root\n'
            'RUN apt-get update && apt-get install -y --no-install-recommends '
            'docker-compose-plugin docker-buildx-plugin netcat-openbsd util-linux '
            '&& rm -rf /var/lib/apt/lists/*\n'
            'COPY --chmod=755 kobo-vps-entrypoint /usr/local/bin/kobo-vps-entrypoint\n'
            'RUN chmod a+r /app/package.json /app/package-lock.json /app/CHANGELOG.md '
            '&& chmod -R a+rX /app/dist /app/src/client/dist\n')
        self.logged(['docker', 'build', '--progress=plain', '-t', image, str(overlay)])
        self.run(['docker', 'run', '--rm', '--network', 'none', '--entrypoint', 'docker',
                  image, 'compose', 'version'])
        self.run(['docker', 'run', '--rm', '--network', 'none', '--entrypoint', 'node', image,
                  '-e', "require('better-sqlite3')(':memory:').close();require('node-pty')"])
        self.run(['docker', 'run', '--rm', '--network', 'none', '--entrypoint', 'kobo-vps-entrypoint',
                  image, 'node', '-e', "if(process.getuid()===0)process.exit(1);"
                  "const fs=require('fs');const dir='/app/src/client/dist/';"
                  "const mode=['pwa','spa'].find(m=>fs.existsSync(dir+m+'/index.html'));"
                  "if(!mode)throw Error('Missing built UI');fs.accessSync(dir+mode+'/index.html',fs.constants.R_OK);"
                  "require('better-sqlite3')(':memory:').close();require('node-pty')"])
        return image

    skip_backup = False

    def backup(self):
        skip = self.skip_backup
        db_files = {f'./.config/kobo/{name}' for name in ('kobo.db','kobo.db-wal','kobo.db-shm')}
        # --skip-backup: no archive; a transient tar of the SQLite files still feeds the migration test.
        archive = self.job / ('migration-check.tar' if skip else 'kobo.tar.gz')
        # Sidecars are normally absent after a clean stop: only existing files reach tar (portable, no GNU-only
        # flag); an empty list still yields a valid empty archive and the kobo.db check below remains.
        script = ('cd /data && set -- && for f in ' + ' '.join(sorted(db_files)) +
                  '; do if [ -e "$f" ] || [ -L "$f" ]; then set -- "$@" "$f"; fi; done'
                  ' && exec tar -cf - -T /dev/null "$@"')
        command = ['sh', self.old_image, '-c', script] if skip else ['tar', self.old_image, '-C', '/data', '-czf', '-', './.config/kobo']
        label = 'database copy' if skip else 'backup'
        with archive.open('xb') as f, self.log.open('ab') as err:
            try:
                subprocess.run(['docker', 'run', '--rm', '--network', 'none', '--read-only',
                    '--mount', f'type=volume,src={self.volume},dst=/data,readonly',
                    '--entrypoint', *command],
                    stdout=f, stderr=err, check=True, timeout=3600)
                f.flush()
                os.fsync(f.fileno())
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
                raise UpdateError(f'Failed: {label}. The previous version will be restarted.') from e
        check = self.job / 'migration-check'
        check.mkdir()
        # Read the complete stream; extract only DB files as regular files, never symlinks.
        try:
            with tarfile.open(archive, 'r|' if skip else 'r|gz') as tar:
                for member in tar:
                    if member.name in db_files:
                        if not member.isfile():
                            raise UpdateError(f'Unexpected SQLite file in {label}.')
                        with tar.extractfile(member) as src, (check / Path(member.name).name).open('wb') as dst:
                            shutil.copyfileobj(src, dst)
        finally:
            if skip:
                archive.unlink()
        if not (check / 'kobo.db').is_file():
            raise UpdateError(f'{label.capitalize()} does not contain the Kōbō database.')
        return check

    def verify(self, version):
        self.container = self.run(self.compose('ps', '-q', 'kobo'))
        self.run(['docker', 'exec', self.container, 'node', '-e', API_JS])
        last_error = None
        for attempt in range(15):
            try:
                with urllib.request.urlopen(self.public_url + '/api/health', timeout=10) as r:
                    health = json.load(r)
                if health.get('version') != version or health.get('status') != 'ok':
                    raise UpdateError('Unexpected HTTPS version or health status.')
                try:
                    with urllib.request.urlopen(self.public_url + '/api/workspaces', timeout=10):
                        raise UpdateError('The public API no longer requires authentication.')
                except urllib.error.HTTPError as e:
                    if e.code != 401:
                        raise UpdateError('Unexpected public API authentication response.') from e
                return
            except Exception as e:
                last_error = e
                if attempt < 14:
                    time.sleep(2)
        raise UpdateError('HTTPS verification failed.') from last_error

    def execute(self, requested, check_only=False, prepare_only=False, skip_backup=False):
        # Only a real deployment backs up; main() rejects the flag with --check/--prepare.
        self.skip_backup = skip_backup and not (check_only or prepare_only)
        for state in (self.stack / 'updates').glob('*/state.json'):
            if json.loads(state.read_text())['phase'] not in {'complete','prepared','aborted'}:
                raise UpdateError(f'Interrupted update requires review: {state}. See RECOVERY.md in that directory.', code='interrupted-update')
        old_tag = self.inspect()
        version, sha = self.resolve(requested)
        say(f'Installed: {self.installed} — target: {version} ({sha[:12]}).')
        if not prepare_only:
            self.maintenance('GET')
        if check_only:
            say('Checks passed. No shutdown or update performed.')
            return
        if version == self.installed and not prepare_only:
            say('This version is already installed. Nothing to do.')
            self.report('up-to-date')
            return
        if self.skip_backup:
            say('WARNING: --skip-backup: no kobo.tar.gz archive will be created. '
                'This update has no Kōbō data recovery point; a failed new version cannot be rolled back from it.')
        updates = self.stack / 'updates'
        updates.mkdir(mode=0o700, exist_ok=True)
        self.job = Path(tempfile.mkdtemp(prefix=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ-'), dir=updates))
        self.log = self.job / 'update.log'
        self.log.touch(mode=0o600)
        (self.job / 'compose.before.yaml').write_bytes(self.original)
        self.record('building', previous_image=old_tag, previous_digest=self.old_image,
                    volume=self.volume, version=version, sha=sha,
                    maintenance_owner=self.maintenance_owner,
                    backup_archive=None if self.skip_backup else 'kobo.tar.gz',
                    backup_scope=None if self.skip_backup else '/root/.config/kobo',
                    backup_skipped=self.skip_backup,
                    backup_complete=False, new_version_start_attempted=False,
                    # A UI run only: lets a later timer run re-send a recovery-required report.
                    **({'ui_request_id': self.ui['id']} if self.ui else {}))
        self.recovery_notes()
        stopped = False
        launching = False
        maintenance_requested = False
        try:
            say(f'Building the image; Kōbō remains available. Log: {self.log}')
            image = self.build(version, sha)
            candidate = self.job / 'compose.next.yaml'
            candidate.write_text(image_config(self.original.decode(), image))
            self.run(self.compose('config', '--quiet', file=candidate))
            if prepare_only:
                self.record('prepared', image=image)
                say(f'Image ready: {image}. Service was not interrupted.')
                return
            self.idle()  # Agents may have started while the build ran.
            if self.compose_file.read_bytes() != self.original:
                raise UpdateError('Compose changed during the build. Aborting without deployment.')
            if json.loads(self.run(self.compose('config', '--format', 'json'))) != self.config_snapshot:
                raise UpdateError('Resolved Compose configuration changed during the build (environment or files). Aborting.')
            self.record('reserving', image=image)
            # Set before sending: a lost response can still mean the server acquired our reservation.
            maintenance_requested = True
            if self.forced_stop():
                self.stop_agents()  # also takes the reservation, so no maintenance('POST')
            else:
                self.maintenance('POST')
            self.record('stopping')
            stopped = True  # Also recover if the stop command itself fails/interruption arrives.
            say('Stopping Kōbō, SKIPPING the backup (--skip-backup) and testing migrations on a database copy…'
                if self.skip_backup else
                'Stopping Kōbō, backing up only /root/.config/kobo and testing migrations on a database copy…')
            self.run(self.compose('stop', '-t', str(STOP_GRACE_SECONDS), 'kobo'),
                     timeout=STOP_GRACE_SECONDS + 30)
            info = json.loads(self.run(['docker', 'inspect', self.container]))[0]
            if info['State']['Running']:
                raise UpdateError('The container did not stop.')
            check = self.backup()
            if self.skip_backup:
                self.record('backup-skipped')  # backup_complete stays false: nothing to restore from.
            else:
                self.record('backed-up', backup_complete=True)
            self.logged(['docker', 'run', '--rm', '--network', 'none',
                         '--mount', f'type=bind,src={check},dst=/check', '--entrypoint', 'node',
                         image, '--input-type=module', '-e', MIGRATION_JS], timeout=180)
            atomic_write(self.compose_file, candidate.read_bytes(), self.original_mode)
            # From here migrations/automatic jobs may have run. Never automatically restore old data.
            launching = True
            self.record('launching', new_version_start_attempted=True)
            say('Starting the new version and checking the API and HTTPS…')
            self.logged(self.compose('up', '-d', '--no-deps', '--wait', '--wait-timeout', '180', 'kobo'), timeout=240)
            self.verify(version)
            self.record('complete')
            say(f'Kōbō {version} is up to date. No backup was created (--skip-backup).' if self.skip_backup
                else f'Kōbō {version} is up to date. Backup: {self.job / "kobo.tar.gz"}')
        except BaseException as e:
            if stopped and not launching:
                # Only safe before any process from the new version has used production data.
                try:
                    # A failed/interrupted CLI does not prove the daemon's stop completed.
                    # Keep admission reserved until the old process is confirmed gone.
                    info = json.loads(self.run(['docker', 'inspect', self.container]))[0]
                    if info['State']['Running']:
                        self.run(['docker', 'stop', '-t', str(STOP_GRACE_SECONDS), self.container],
                                 timeout=STOP_GRACE_SECONDS + 30)
                        info = json.loads(self.run(['docker', 'inspect', self.container]))[0]
                        if info['State']['Running']:
                            raise UpdateError('Previous process shutdown is unconfirmed.')
                    atomic_write(self.compose_file, self.original, self.original_mode)
                    self.logged(self.compose('up', '-d', '--no-deps', '--wait', '--wait-timeout', '180', 'kobo'), timeout=240)
                    self.record('aborted')
                    say('Update aborted; previous version restarted, original database unchanged.')
                except BaseException:
                    self.record('recovery-required')
                    say(f'Restart requires review. Instructions: {self.job / "RECOVERY.md"}')
            elif launching:
                self.record('recovery-required')
                say(f'New version requires diagnosis. Data retained; no automatic database rollback. See {self.job / "RECOVERY.md"}')
            else:
                try:
                    if maintenance_requested:
                        self.maintenance('DELETE')
                    self.refused = e.code if isinstance(e, UpdateError) else None
                    self.record('aborted')
                except BaseException:
                    self.record('recovery-required')
                    say(f'Update reservation may still be active. Instructions: {self.job / "RECOVERY.md"}')
            raise

    def stop_agents(self):
        self.report('stopping-agents')
        reply = self.trigger('POST', 'update-trigger/stop-agents',
                             {'id': self.ui['id'], 'owner': self.maintenance_owner}, 60)
        body = (reply or {}).get('body')
        body = body if isinstance(body, dict) else {}
        status = (reply or {}).get('status')
        if status == 200 and body.get('reserved') is True and type(body.get('unconfirmed')) is int and body['unconfirmed'] == 0:
            return
        if status == 409 and body.get('code') == 'conflict':
            raise UpdateError('Another update is already running.', code='already-running')
        if status == 409 and body.get('code') == 'busy':
            raise UpdateError(BUSY_MESSAGE, code='busy')
        # No code, another status, a lost or malformed reply (e.g. Kōbō restarted and forgot the request).
        raise UpdateError('The request to stop the agents was not accepted by Kōbō', code='unknown')

    def recovery_notes(self):
        import shlex
        restart = shlex.join(self.compose('up', '-d', '--no-deps', '--wait', 'kobo'))
        if self.skip_backup:
            archive = '''NO BACKUP ARCHIVE EXISTS for this update: it ran with --skip-backup
(state.json: backup_skipped=true, backup_complete=false). Any `migration-check`
directory is a disposable, possibly migrated database copy, NOT a backup.
Claude/Codex credentials, skills/plugins, caches and projects remain in the
original volume.'''
            rollback = '''This update cannot roll back Kōbō data: no archive was created. Stop Kōbō,
preserve the current volume and restore .config/kobo only from a backup you made
yourself, into a NEW cloned volume, with the previous Compose configuration and
the previous immutable image above. Kōbō's own daily `kobo.db.backup-*` files in
.config/kobo predate this update but cover the database only. Keep the original
volume.'''
        else:
            archive = '''The archive `kobo.tar.gz` is validated only when backup_complete=true.
It contains ONLY /root/.config/kobo, with paths relative to /root.
Claude/Codex credentials, skills/plugins, caches and projects are NOT included;
back up those files separately if needed. They remain in the original volume.'''
            rollback = '''To roll back Kōbō data, stop Kōbō and preserve the current volume. Clone that
stopped volume into a NEW Docker volume to retain current engine credentials,
skills and other files outside .config/kobo. In the NEW volume only, replace
.config/kobo completely with the contents of kobo.tar.gz (extract at the volume
root, preserving numeric owners and permissions). Do not merge the old database
with newer WAL/SHM files or other new-version Kōbō files. Adapt the previous
Compose configuration to use that restored volume and the previous immutable
image above. Keep the original volume. This archive cannot roll back files
outside .config/kobo, external agent actions or project changes.'''
        (self.job / 'RECOVERY.md').write_text(f'''# Kōbō update recovery

Private log: `{self.job / 'update.log'}`. Durable phase: `state.json`.
Previous configuration: `compose.before.yaml`.
Previous immutable image: `{self.old_image}`.
Original volume: `{self.volume}`.
{archive}
new_version_start_attempted indicates whether a new-version launch was attempted.
Old images, volumes and backups are never automatically deleted.

## Interrupted admission reservation
The runtime reservation blocks agent starts and defers scheduled deliveries until
the container stops or the owner explicitly releases it. It does not expire.
If phase is reserving/stopping/recovery-required, inspect whether the old process
is still running. Before any new-version launch, stop it with Docker and confirm
it has exited before restarting the previous configuration below; this clears
the in-memory reservation. Do not release admission while a Docker stop may still
be in progress. The reservation identifier is state.json's maintenance_owner.

## Before a new-version launch
If no new-version launch was attempted, restore compose.before.yaml to
`{self.compose_file}` and run:

```sh
{restart}
```

Verify service health before setting state.json phase to aborted to allow a retry.

## After a new-version launch (launching/recovery-required)
Do not run an older image against a potentially migrated database.
Inspect the private log and Compose logs (which may contain credentials).
A proxy error can leave a working backend: check for new messages and resumed
work before considering a restore.
{rollback}
After recovery and health verification, set state.json phase to complete or aborted.
''')


def unit_files(stack, script, user):
    if not UNIT_USER.fullmatch(user):
        raise UpdateError('The stack directory owner has a user name that cannot be used in a systemd unit.')
    for path in (stack, script):
        if UNSAFE_UNIT_PATH.search(str(path)):
            raise UpdateError(f'Unsupported path for a systemd unit (spaces, quotes, backslash, % or $): {path}')
    return {
        f'{UNIT_NAME}.service': f"""[Unit]
Description=Run a Kōbō update requested from the web interface
After=docker.service

[Service]
Type=oneshot
User={user}
WorkingDirectory={stack}
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={script} --serve-ui-request --directory {stack}
TimeoutStopSec=600
KillMode=mixed
""",
        f'{UNIT_NAME}.timer': f"""[Unit]
Description=Poll Kōbō for an update requested from the web interface

[Timer]
OnBootSec=1min
OnUnitInactiveSec=1min
AccuracySec=5s
Unit={UNIT_NAME}.service

[Install]
WantedBy=timers.target
""",
    }


def owner_uid(stack):
    return os.stat(stack).st_uid


def systemctl(*args):
    try:
        ok = subprocess.run(['systemctl', *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            timeout=60, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        ok = False
    return ok


def require_root():
    if os.geteuid() != 0:
        raise UpdateError('Run this once with sudo: it writes systemd units.')


def check_script(script, uid):
    """The timer runs this file every minute as the stack owner: nobody else may be able to change it."""
    if not script.is_file():
        raise UpdateError(f'The updater script was not found: {script}')
    for path, what in ((script, 'script'), (script.parent, 'script directory')):
        st = path.stat()
        if st.st_uid not in (0, uid):
            raise UpdateError(f'The {what} {path} must be owned by root or by the stack owner.')
        if st.st_mode & 0o022:
            raise UpdateError(f'The {what} {path} must not be writable by group or others.')
    # Checked as root, for whom any exec bit is enough. The unit runs the script as the stack owner:
    # owned by the stack owner, it needs the owner's read and exec bits; owned by root, it needs the
    # read and exec bits for others. Group membership is not resolved: group bits never count.
    st = script.stat()
    if st.st_uid == uid:
        if st.st_mode & 0o500 != 0o500:
            raise UpdateError(f'The updater script is not executable: chmod +x {script}')
    elif st.st_mode & 0o005 != 0o005:
        raise UpdateError(f'The updater script is not executable by the stack owner: a root-owned script must be '
                          f'readable and executable by others (chmod o+rx {script}).')
    with script.open('rb') as f:
        if f.read(2) != b'#!':
            raise UpdateError(f'The updater script has no #! first line: {script}')


def install_ui_trigger(stack, unit_dir=UNIT_DIR, *, script=None):
    require_root()
    if not unit_dir.is_dir() or not shutil.which('systemctl'):
        raise UpdateError(f'This host does not use systemd (no systemctl or no {unit_dir}): cannot install the trigger.')
    stack = Path(stack).resolve()
    if not (stack / 'compose.yaml').is_file():
        raise UpdateError(f'No compose.yaml in {stack}.')
    uid = owner_uid(stack)
    if uid == 0:
        raise UpdateError('The stack directory is owned by root: the updater would run as root. Use the deployment user.')
    try:
        user = pwd.getpwuid(uid).pw_name
    except KeyError:
        raise UpdateError(f'The stack directory owner (uid {uid}) has no user entry.')
    script = Path(script or __file__).resolve()
    files = unit_files(stack, script, user)
    check_script(script, uid)
    paths = {unit_dir / name: text for name, text in files.items()}
    previous = {path: path.read_bytes() if path.exists() else None for path in paths}
    try:
        for path, text in paths.items():
            atomic_write(path, text.encode(), 0o644)
        if not (systemctl('daemon-reload') and systemctl('enable', '--now', f'{UNIT_NAME}.timer')):
            raise UpdateError(f'systemctl failed: the trigger was not installed. '
                              f'Run "systemctl status {UNIT_NAME}.timer" to see why.')
    except BaseException:
        # Best effort, never replaces the original error: restore a previous install, drop a new one.
        for path, old in previous.items():
            try:
                if old is None:
                    path.unlink(missing_ok=True)
                else:
                    atomic_write(path, old, 0o644)
            except Exception:
                pass
        if previous[unit_dir / f'{UNIT_NAME}.timer'] is None:
            systemctl('disable', '--now', f'{UNIT_NAME}.timer')
        systemctl('daemon-reload')
        raise
    say(f'Update trigger installed: Kōbō is polled every minute, as {user}.')
    say(f'Remove it with: sudo {script} --uninstall-ui-trigger')


def uninstall_ui_trigger(unit_dir=UNIT_DIR):
    require_root()
    systemctl('disable', '--now', f'{UNIT_NAME}.timer')  # fine when the unit is not loaded
    for name in (f'{UNIT_NAME}.timer', f'{UNIT_NAME}.service'):
        (unit_dir / name).unlink(missing_ok=True)
    if not systemctl('daemon-reload'):
        raise UpdateError('systemctl daemon-reload failed.')
    say('Update trigger removed.')


@contextlib.contextmanager
def update_lock(directory):
    with (directory / '.update.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise UpdateError('Another update is already running.', code='already-running')
        yield


def serve_ui_request(stack):
    """Timer entry point: run the update the web UI asked for, if any. Silent otherwise; 1 while recovery is needed."""
    # A failed unit is the operator's only signal when the web interface is down: keep it failed,
    # without polling, until the operator ends the recovery (unreadable states are left to execute()).
    recovery = []
    for state in sorted(Path(stack).glob('updates/*/state.json')):
        try:
            values = json.loads(state.read_text())
            phase = values.get('phase')
        except (OSError, ValueError, AttributeError):
            continue
        if phase == 'recovery-required':
            recovery.append((state.parent.name, values.get('ui_request_id')))
    if recovery:
        for _, request_id in recovery:
            if isinstance(request_id, str):
                # The report sent at the failure is lost if the new version was not answering yet.
                # Kōbō adopts it only while it tracks nothing else, so repeating it is harmless.
                updater = Updater(stack)
                updater.ui = {'id': request_id, 'skipBackup': False, 'stopAgents': False}
                updater.report('recovery-required')
        say(f'Update {recovery[0][0]} requires recovery: see RECOVERY.md in its directory.')
        return 1
    updater = Updater(stack)
    with contextlib.ExitStack() as held:
        try:
            # Before polling: the poll settles an unfinished status, which is only right while no
            # update runs. A held lock means one does; the request stays pending for the next run.
            held.enter_context(update_lock(updater.stack))
        except UpdateError:
            return 0
        except OSError:
            # Typically a lock left root-owned by a past `sudo kobo-update`: say so, do not fail the unit.
            say('Cannot open the update lock in the stack directory; check its owner.')
            return 0
        if not updater.locate():
            return 0
        reply = updater.trigger('GET', 'update-trigger/poll')
        body = reply.get('body') if reply and reply.get('status') == 200 else None
        request = body.get('request') if isinstance(body, dict) else None
        if not isinstance(request, dict) or not isinstance(request.get('id'), str):
            return 0
        updater.ui = {'id': request['id'], 'skipBackup': request.get('skipBackup') is True,
                      'stopAgents': request.get('stopAgents') is True}
        try:
            updater.execute('latest', skip_backup=updater.ui['skipBackup'])
        except (Exception, KeyboardInterrupt) as e:
            say(f'Stopped: {str(e) if isinstance(e, UpdateError) else type(e).__name__}.')
            if updater.reported not in FINAL_PHASES:  # otherwise record() already reported the outcome
                phase = updater.state.get('phase')
                if phase == 'recovery-required':
                    updater.report('recovery-required')
                elif phase in (None, 'building', 'reserving'):  # the container was never stopped
                    updater.report('refused', (e.code if isinstance(e, UpdateError) else None) or 'unknown')
    # A failed unit is the operator's only signal when the web interface is down.
    return 1 if updater.state.get('phase') == 'recovery-required' else 0


def main():
    parser = argparse.ArgumentParser(description='Update a Kōbō VPS Compose stack (latest stable release by default).')
    parser.add_argument('version', nargs='?', default='latest', help='latest, 2.1.16 or v2.1.16')
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--check', action='store_true', help='check without building or interrupting the service')
    modes.add_argument('--prepare', action='store_true', help='build and test the image without deploying')
    modes.add_argument('--install-ui-trigger', action='store_true',
                       help='install the systemd timer that runs updates requested from the web interface (sudo)')
    modes.add_argument('--uninstall-ui-trigger', action='store_true',
                       help='remove that systemd timer (sudo)')
    modes.add_argument('--serve-ui-request', action='store_true',
                       help='run the update requested from the Kōbō web interface, if any (for a timer)')
    parser.add_argument('--directory', type=Path, default=Path.cwd(),
                        help='deployment directory containing compose.yaml and .env (default: current directory)')
    parser.add_argument('--skip-backup', action='store_true',
                        help='deploy without creating the kobo.tar.gz backup: no Kōbō data recovery point for this '
                             'update (the migration test on a database copy still runs)')
    args = parser.parse_args()
    if args.skip_backup and (args.check or args.prepare):
        parser.error('--skip-backup only applies to a real deployment, not --check or --prepare')
    for flag, selected in (('--serve-ui-request', args.serve_ui_request),
                           ('--install-ui-trigger', args.install_ui_trigger),
                           ('--uninstall-ui-trigger', args.uninstall_ui_trigger)):
        if selected and (args.skip_backup or args.version != 'latest'):
            parser.error(f'{flag} does not take --skip-backup or a version')
    os.umask(0o077)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    if args.serve_ui_request:
        return serve_ui_request(args.directory)
    try:
        if args.install_ui_trigger:
            install_ui_trigger(args.directory)
        elif args.uninstall_ui_trigger:
            uninstall_ui_trigger()
        else:
            with update_lock(args.directory):
                Updater(args.directory).execute(args.version, args.check, args.prepare, args.skip_backup)
    except (Exception, KeyboardInterrupt) as e:
        message = str(e) if isinstance(e, UpdateError) else type(e).__name__
        say(f'Stopped: {message}.')
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
